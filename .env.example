# FreshGuard AI - Environment Configuration Template
# Strictly MySQL only - SQLite is prohibited in this project

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=freshguard_db

SECRET_KEY=replace_with_a_secure_random_key
CONFIDENCE_THRESHOLD=0.60
FLASK_ENV=production
